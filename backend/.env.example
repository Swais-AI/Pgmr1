# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.

# PostgreSQL connection string.
# Local dev:  postgresql://postgres:password@localhost:5432/sgs_local
# Production: postgresql://username:password@hostname:5432/database_name
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Table name prefix used by the application.
# Local dev  : leave empty (plain table names, e.g. assignment_master)
# RDS / prod : set to "sgs_" (prefixed table names, e.g. sgs_assignment_master)
DB_TABLE_PREFIX=

# ── Parent identity ───────────────────────────────────────────────────────────
# Shared secret the login portal presents when requesting a token for a parent.
# Must equal SGS_SSO_SECRET in the sgs-frontend (login) app's .env.
SSO_SECRET=

# This service's own token signing key. Long, random, never shared with any
# other service. e.g.  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Token lifetime in hours (default 24).
JWT_EXPIRE_HOURS=24

# ── AWS S3 (assignment PDF attachments) ──────────────────────────────────────
# IAM credentials with s3:GetObject on the sgs-bucket-images bucket.
# boto3 also accepts these via instance profile / ECS task role (leave blank).
# NEVER commit real credentials here — use IAM roles in production where possible.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bucket region — must match where sgs-bucket-images is hosted.
AWS_REGION=ap-south-2
# Presigned URL lifetime in seconds (default 3600 = 1 hour).
# S3_PRESIGN_EXPIRY=3600

# ── Development-only demo parent fallback ─────────────────────────────────────
# Set to "development", "dev", or "local" to allow unauthenticated requests to
# fall back to demo parent id=10. NEVER set this in production.
# APP_ENV=development
APP_ENV=production
