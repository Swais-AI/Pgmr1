# Copy this file to .env.local and fill in the values for your environment.
# Never commit .env.local to version control.

# Backend API base URL.
# On EC2: set this to http://<EC2-PUBLIC-IP>:8000
# Locally: leave as http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI engine URL (SGS AI Engine).
# Set to the deployed AI server URL for your environment.
NEXT_PUBLIC_AI_API_URL=https://your-ai-server/api/ai

# Set to "true" to enable AI features. Set to "false" to hide all AI buttons
# without breaking any existing functionality (safe for demos, QA, outages).
NEXT_PUBLIC_ENABLE_AI=true

# SGS portal URL — used for logout redirection.
# Must be set in every environment. No fallback; missing value is reported as a configuration error.
NEXT_PUBLIC_SGS_URL=https://sgs.swais.in
